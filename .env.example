# ── Main App ──────────────────────────────────────────────────────────────────

# Solver API (required - contract addresses come from quote response)
SOLVER_URL=https://solver-magenta.eco.com

# RPC Endpoints (Mainnet - public, no signup needed)
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com
RONIN_RPC_URL=https://api.roninchain.com/rpc
INK_RPC_URL=https://rpc-gel-sepolia.inkonchain.com

# Wallet (your private keys)
PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# Test Config
RUN_E2E=true
TEST_AMOUNT_USDC=1000000
TEST_REWARD_USDC=100000
POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=info

# ── Circuit Breaker ───────────────────────────────────────────────────────────

# Solver
CB_SOLVER_URL=https://solver-magenta.eco.com

# Routes file (relative to repo root)
CB_ROUTES_FILE=tests/circuit-breaker/routes.json

# Wallet - EVM private key (must include 0x prefix), recipient is your EVM address
CB_WALLET_PRIVATE_KEY=0x
CB_WALLET_RECIPIENT=

# RPC URLs as a JSON object (chain ID → URL)
CB_RPC_URLS={"1":"https://ethereum.publicnode.com","10":"https://mainnet.optimism.io","137":"https://polygon-bor.publicnode.com","2020":"https://api.roninchain.com/rpc","8453":"https://mainnet.base.org","42161":"https://arb1.arbitrum.io/rpc","1399811149":"https://solana-rpc.publicnode.com"}

# Solana private key (Base58) - falls back to SOLANA_PRIVATE_KEY if not set
# CB_SOLANA_PRIVATE_KEY=

# Test settings
CB_TEST_AMOUNT=0.1
CB_PUBLISH_CONCURRENCY=1

# Timeouts (ms)
CB_TIMEOUT_PUBLISH_MS=60000
CB_TIMEOUT_FULFILLMENT_WAIT_MS=300000
CB_TIMEOUT_FULFILLMENT_VERIFY_MS=60000
CB_TIMEOUT_PROVING_WAIT_MS=600000
CB_TIMEOUT_PROVING_VERIFY_MS=60000

# Polling backoff
CB_POLL_INITIAL_MS=15000
CB_POLL_MULTIPLIER=1.5
CB_POLL_MAX_MS=60000

# Reporting
CB_REPORT_PATH=circuit-breaker-report.json
# CB_ALERT_ENDPOINT=
# CB_ALERT_AUTH_HEADER=
