# Solver API (required - contract addresses come from quote response)
SOLVER_URL=https://solver-magenta.eco.com

# RPC Endpoints (Mainnet - public, no signup needed)
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Solana RPC (Mainnet - public, no signup needed)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Wallet (your private keys)
# EVM wallet (0x format, 66 characters)
PRIVATE_KEY=

# Solana wallet (Base58 format, e.g., 5Jd7F...)
# Get your private key from: Phantom, Solflare, or solana-keygen
SOLANA_PRIVATE_KEY=

# Test Config
RUN_E2E=true
TEST_AMOUNT_USDC=1000000
TEST_REWARD_USDC=100000
POLL_INTERVAL_MS=5000

# Logging
LOG_LEVEL=info
